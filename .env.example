# Authentication
NEXTAUTH_SECRET="your-nextauth-secret"

# Firebase Admin SDK
AUTH_FIREBASE_PROJECT_ID="your-firebase-project-id"
AUTH_FIREBASE_CLIENT_EMAIL="your-firebase-client-email"
AUTH_FIREBASE_PRIVATE_KEY="your-firebase-private-key"

# NAV API (Norwegian Labour and Welfare Administration)
NAVPIM_KEY="your-nav-api-key"

# Pinecone Vector Database
PINECONE_API_KEY="your-pinecone-api-key"

# App URL (optional, defaults to http://localhost:3000)
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
